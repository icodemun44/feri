generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  SELLER
  ADMIN

  @@map("role")
}

enum SellerApplicationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED

  @@map("seller_application_status")
}

enum SellerStatus {
  ACTIVE
  SUSPENDED

  @@map("seller_status")
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR

  @@map("product_condition")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  REMOVED

  @@map("product_status")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  COD

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum BannerTone {
  UMBER
  CLAY
  INK
  TAUPE

  @@map("banner_tone")
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authId      String    @unique @map("auth_id") @db.Uuid
  email       String    @unique
  role        Role      @default(BUYER)
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile              UserProfile?
  seller               Seller?
  sellerApplications   SellerApplication[] @relation("ApplicationApplicant")
  reviewedApplications SellerApplication[] @relation("ApplicationReviewer")
  orders               Order[]
  reviews              Review[]
  auditLogs            AuditLog[]

  @@index([role])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  bio       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products           Product[]
  sellerApplications SellerApplication[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model SellerApplication {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicantId        String                  @map("applicant_id") @db.Uuid
  status             SellerApplicationStatus @default(PENDING)
  businessName       String                  @map("business_name")
  description        String
  contactEmail       String                  @map("contact_email")
  contactPhone       String                  @map("contact_phone")
  city               String
  primaryCategoryId  String?                 @map("primary_category_id") @db.Uuid
  reviewerId         String?                 @map("reviewer_id") @db.Uuid
  reviewStartedAt    DateTime?               @map("review_started_at") @db.Timestamptz(6)
  verificationCallAt DateTime?               @map("verification_call_at") @db.Timestamptz(6)
  verificationNotes  String?                 @map("verification_notes")
  decidedAt          DateTime?               @map("decided_at") @db.Timestamptz(6)
  decisionReason     String?                 @map("decision_reason")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant       User      @relation("ApplicationApplicant", fields: [applicantId], references: [id])
  reviewer        User?     @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  primaryCategory Category? @relation(fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  seller          Seller?

  @@index([status, createdAt])
  @@index([applicantId])
  @@map("seller_applications")
}

model Seller {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @unique @map("user_id") @db.Uuid
  applicationId String       @unique @map("application_id") @db.Uuid
  slug          String       @unique
  businessName  String       @map("business_name")
  description   String
  contactEmail  String       @map("contact_email")
  contactPhone  String       @map("contact_phone")
  city          String
  logoUrl       String?      @map("logo_url")
  status        SellerStatus @default(ACTIVE)
  approvedAt    DateTime     @default(now()) @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User              @relation(fields: [userId], references: [id])
  application SellerApplication @relation(fields: [applicationId], references: [id])
  products    Product[]
  orders      Order[]
  reviews     Review[]

  @@index([status])
  @@map("sellers")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String           @map("seller_id") @db.Uuid
  categoryId  String           @map("category_id") @db.Uuid
  title       String
  description String
  priceMinor  Int              @map("price_minor")
  condition   ProductCondition
  status      ProductStatus    @default(DRAFT)
  brand       String?
  size        String?
  quantity    Int              @default(1)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(6)
  soldAt      DateTime?        @map("sold_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller     Seller         @relation(fields: [sellerId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([status, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([sellerId, status])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  storagePath String   @map("storage_path")
  altText     String?  @map("alt_text")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

model Order {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber         Int         @unique @default(autoincrement()) @map("order_number")
  buyerId             String      @map("buyer_id") @db.Uuid
  sellerId            String      @map("seller_id") @db.Uuid
  status              OrderStatus @default(PLACED)
  subtotalMinor       Int         @map("subtotal_minor")
  deliveryFeeMinor    Int         @map("delivery_fee_minor")
  totalMinor          Int         @map("total_minor")
  shippingFullName    String      @map("shipping_full_name")
  shippingPhone       String      @map("shipping_phone")
  shippingAddressLine String      @map("shipping_address_line")
  shippingCity        String      @map("shipping_city")
  shippingDistrict    String?     @map("shipping_district")
  deliveryNotes       String?     @map("delivery_notes")
  placedAt            DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  cancelledAt         DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  deliveredAt         DateTime?   @map("delivered_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer   User        @relation(fields: [buyerId], references: [id])
  seller  Seller      @relation(fields: [sellerId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  titleSnapshot  String   @map("title_snapshot")
  unitPriceMinor Int      @map("unit_price_minor")
  quantity       Int
  subtotalMinor  Int      @map("subtotal_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  review  Review?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  method           PaymentMethod @default(COD)
  status           PaymentStatus @default(PENDING)
  amountMinor      Int           @map("amount_minor")
  gatewayReference String?       @map("gateway_reference")
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  reviewerId  String   @map("reviewer_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  reviewer  User      @relation(fields: [reviewerId], references: [id])
  seller    Seller    @relation(fields: [sellerId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([sellerId, createdAt])
  @@index([productId])
  @@map("reviews")
}

model Banner {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  subtitle  String?
  ctaLabel  String?    @map("cta_label")
  ctaHref   String?    @map("cta_href")
  tone      BannerTone @default(UMBER)
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  startsAt  DateTime?  @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime?  @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("banners")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
