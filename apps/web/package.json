{
  "name": "@feri/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "admin:create": "tsx --env-file=../../.env scripts/create-admin.ts",
    "demo:seed": "tsx --env-file=../../.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@feri/database": "workspace:*",
    "@feri/shared": "workspace:*",
    "@feri/ui": "workspace:*",
    "@feri/validation": "workspace:*",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15"
  }
}
